{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/res",
                "${workspaceFolder}/.tools/gbdk/include",
                "${env:GBDK_HOME}/include",
                "${env:GBDKDIR}/include"
            ],
            "defines": ["__PORT_sm83", "__TARGET_gb"],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/res",
                    "${workspaceFolder}/.tools/gbdk/include",
                    "${env:GBDK_HOME}/include",
                    "${env:GBDKDIR}/include"
                ],
                "limitSymbolsToIncludedHeaders": false
            },
            "mergeConfigurations": false
        }
    ],
    "version": 4
}
